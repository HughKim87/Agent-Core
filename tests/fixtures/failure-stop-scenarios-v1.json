{
  "fixture_version": 1,
  "failure_limit": 3,
  "rule_fragments": {
    "PROJECT_RULES.md": [
      "하나의 사용자 결과를 달성하기 위한 전체 실행 연쇄를 같은 작업으로 본다.",
      "같은 작업의 세 번째 실패에서 해당 작업 실행을 중단한다."
    ],
    "rules/work-contract.md": [
      "사용자가 확인된 요구의 미충족을 지적하면 실패다.",
      "실질적으로 변경하면 기존 계약의 실패가 아니라 새 계약 경계다."
    ],
    "rules/failure-records.md": [
      "네 번째 실행을 시작하지 않는다.",
      "새 세션은 이전 카운터를 이어받지 않으며"
    ],
    "rules/handoff.md": [
      "다음 세션이 이어서 증가시킬 실패 카운터",
      "상태 문서를 작성하는 행위는 원 작업의 추가 실패 시도가 아니다."
    ]
  },
  "cases": [
    {
      "id": "different-methods-share-counter",
      "events": [
        {"type": "failure", "task": "deliver-result", "method": "tool-a"},
        {"type": "failure", "task": "deliver-result", "method": "tool-b"},
        {"type": "unmet-requirement-correction", "task": "deliver-result"},
        {"type": "attempt", "task": "deliver-result", "method": "tool-c"}
      ],
      "expected": [
        {"count": 1, "stopped": false, "action": "continue"},
        {"count": 2, "stopped": false, "action": "continue"},
        {"count": 3, "stopped": true, "action": "stop"},
        {"count": 3, "stopped": true, "action": "blocked"}
      ]
    },
    {
      "id": "requirement-change-is-new-contract",
      "events": [
        {"type": "failure", "task": "deliver-result"},
        {"type": "requirement-change", "task": "deliver-result"}
      ],
      "expected": [
        {"count": 1, "stopped": false, "action": "continue"},
        {"count": 0, "stopped": false, "action": "new-contract"}
      ]
    },
    {
      "id": "handoff-is-not-an-attempt",
      "events": [
        {"type": "failure", "task": "deliver-result"},
        {"type": "handoff", "task": "deliver-result"}
      ],
      "expected": [
        {"count": 1, "stopped": false, "action": "continue"},
        {"count": 1, "stopped": false, "action": "handoff"}
      ]
    },
    {
      "id": "new-session-does-not-inherit-counter",
      "events": [
        {"type": "failure", "task": "deliver-result"},
        {"type": "failure", "task": "deliver-result"},
        {"type": "failure", "task": "deliver-result"},
        {"type": "new-session"},
        {"type": "attempt", "task": "deliver-result"}
      ],
      "expected": [
        {"count": 1, "stopped": false, "action": "continue"},
        {"count": 2, "stopped": false, "action": "continue"},
        {"count": 3, "stopped": true, "action": "stop"},
        {"count": 0, "stopped": false, "action": "reset-session"},
        {"count": 0, "stopped": false, "action": "allowed"}
      ]
    },
    {
      "id": "different-tasks-have-separate-counters",
      "events": [
        {"type": "failure", "task": "task-a"},
        {"type": "failure", "task": "task-b"},
        {"type": "failure", "task": "task-a"}
      ],
      "expected": [
        {"count": 1, "stopped": false, "action": "continue"},
        {"count": 1, "stopped": false, "action": "continue"},
        {"count": 2, "stopped": false, "action": "continue"}
      ]
    },
    {
      "id": "success-closes-counter",
      "events": [
        {"type": "failure", "task": "deliver-result"},
        {"type": "success", "task": "deliver-result"}
      ],
      "expected": [
        {"count": 1, "stopped": false, "action": "continue"},
        {"count": 0, "stopped": false, "action": "complete"}
      ]
    },
    {
      "id": "safe-stop-before-execution-is-not-failure",
      "events": [
        {"type": "safe-stop", "task": "deliver-result"}
      ],
      "expected": [
        {"count": 0, "stopped": false, "action": "safe-stop"}
      ]
    }
  ]
}
