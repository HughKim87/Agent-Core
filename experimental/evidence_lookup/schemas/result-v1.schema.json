{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "backend", "execution_mode", "fallback_reason", "partial", "truncated", "result"],
      "properties": {
        "ok": {"const": true},
        "backend": {"enum": ["obsidian", "graphify", "markdown", "python"]},
        "execution_mode": {"enum": ["cold_obsidian", "new_index", "reused_index", "markdown_fallback", "python_fallback"]},
        "fallback_reason": {"type": ["string", "null"]},
        "partial": {"type": "boolean"},
        "truncated": {"type": "boolean"},
        "result": {"type": ["array", "string"]},
        "call_sites": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matches", "incomplete"],
          "properties": {
            "matches": {"type": "array", "maxItems": 100, "items": {
              "type": "object", "additionalProperties": false, "required": ["path", "line"],
              "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}}
            }},
            "incomplete": {"type": "boolean"}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {"ok": {"const": false}, "error": {"type": "string"}}
    }
  ]
}
