{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "target", "source_roots", "executable", "cache"],
  "properties": {
    "tool": {"enum": ["obsidian", "graphify"]},
    "target": {"type": "string", "minLength": 1},
    "source_roots": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"type": "string", "minLength": 1}},
    "executable": {"type": ["string", "null"]},
    "cache": {"type": "string", "minLength": 1}
  }
}
