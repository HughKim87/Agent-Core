{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-core://experimental/shared_data/schemas/source-payload-v1.schema.json",
  "title": "Source Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_kind", "locator", "observed_at", "verification_status", "evidence_role", "version_or_hash"],
  "properties": {
    "source_kind": {"enum": ["local_document", "local_data", "command_result", "web_page", "user_statement"]},
    "locator": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "verification_status": {"enum": ["observed", "verified", "unavailable"]},
    "evidence_role": {"enum": ["primary", "supporting", "contextual"]},
    "version_or_hash": {"type": ["string", "null"]}
  }
}
